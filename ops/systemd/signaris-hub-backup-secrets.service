[Unit]
Description=Signaris Hub — зашифрованный архив ключей и .env

[Service]
Type=oneshot
# Отдельным юнитом, а не вторым ExecStart у backup-files.service: у
# Type=oneshot первый упавший ExecStart отменяет остальные, и сбой архива
# ключей утащил бы за собой ночной снапшот вложений.
User=root
ExecStart=/opt/signaris-hub/scripts/backup-secrets.sh
StandardOutput=journal
StandardError=journal
