# Copy this file to deploy/.env and fill in real values from local Hub/CLAUDE.md → СЕКРЕТЫ.
# deploy/.env is gitignored — never commit it.

# Основной путь — прямой на публичный адрес.
SERVER_HOST=94.241.168.8
SERVER_USER=root

# Запасной адрес на случай, когда публичный закрыт блокировкой (31.08 трафик
# из части сетей умирал за stormwall.bix.bg при полностью живом сервере).
# Тайнет-нода `hub-vps`; требует включённого Tailscale. Скрипт проверяет
# основной адрес и переезжает сюда САМ — и только если этот тоже отвечает.
# Оставьте пустым, если тайнета нет: тогда обхода просто не будет.
SERVER_HOST_FALLBACK=100.104.237.105

# Основной путь — ssh-ключ (генерация: ssh-keygen -t ed25519 -f ~/.ssh/signaris_hub_deploy;
# публичный ключ добавить в /root/.ssh/authorized_keys на VPS).
SSH_KEY=~/.ssh/signaris_hub_deploy
# Третий эшелон: промежуточный узел для ssh/rsync (`ssh -J`). Нужен, только
# если недоступны ОБА адреса выше. Оставьте пустым, если ходите напрямую.
# SSH_JUMP=root@100.x.y.z

# Fallback, если ключ не настроен (пароль из CLAUDE.md → СЕКРЕТЫ).
SERVER_PASS=<paste from CLAUDE.md СЕКРЕТЫ — VPS root password>
